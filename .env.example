# 方案配套配置示例；复制到未来实现项目的受控环境后填写。
# 不包含真实密钥，不要将填写后的.env提交Git。
APP_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_URL=mysql+asyncmy://tongpin:CHANGE_ME@localhost:3306/tongpin
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
COOKIE_SECURE=false
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash
API_TIMEOUT_MS=600000
MAX_RUN_STEPS=12
MAX_TOOL_CALLS=8
MAX_RUN_BOTS=3
MAX_UPLOAD_MB=20
OSS_BUCKET=wh-syyoss
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_HOST=https://wh-syyoss.oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Electron构建期公开配置示例；这些值可从安装包中读取。
# 不得在此添加模型密钥、OSS secret、数据库密码或JWT签名密钥。
# 桌面Main构建读取；Renderer通过受限IPC使用业务能力。
DESKTOP_API_BASE_URL=https://api.example.com/api/v1
DESKTOP_WEBSITE_BASE_URL=https://www.example.com
DESKTOP_UPDATE_FEED_URL=https://downloads.example.com/updates/windows/x64/stable
DESKTOP_APP_ID=com.tongpin.desktop
DESKTOP_DEEP_LINK_SCHEME=tongpin

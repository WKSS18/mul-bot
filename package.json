{
  "name": "tongpin-ai",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "website:dev": "npm run dev -w @tongpin/website",
    "workbench:dev": "npm run dev -w @tongpin/workbench-app",
    "website:build": "npm run build -w @tongpin/website",
    "workbench:build": "npm run build -w @tongpin/workbench-app",
    "desktop:dev": "npm run dev -w @tongpin/desktop",
    "build": "npm run website:build && npm run workbench:build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "antd": "6.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {"@vitejs/plugin-react": "5.0.4", "vite": "6.4.2", "electron": "35.0.0"}
}

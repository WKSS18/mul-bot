FROM python:3.12-slim
WORKDIR /srv/backend
# Keep the runtime build independent of apt mirrors. Document rendering falls
# back to the fonts available in the base image when CJK fonts are unavailable.
COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini
RUN pip install --no-cache-dir .
ENV APP_ENV=production PYTHONUNBUFFERED=1 DOCUMENT_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

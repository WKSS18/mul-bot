FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY vitest.config.mjs ./
# The web bundle does not need Electron's native postinstall download.
RUN npm ci --ignore-scripts && npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/website/ /usr/share/nginx/html/
COPY --from=build /src/dist/workbench/index.html /usr/share/nginx/html/workbench.html
COPY --from=build /src/dist/workbench/workbench-assets/ /usr/share/nginx/html/workbench-assets/
